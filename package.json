{
  "name": "wt-dash",
  "version": "0.1.0",
  "description": "A macOS and Linux terminal dashboard for reviewing and cleaning up Git worktrees across repositories.",
  "license": "MIT",
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "engines": {
    "bun": ">=1.3.14"
  },
  "bin": {
    "wt-dash": "src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "build": "bun scripts/build.ts",
    "formula": "bun scripts/homebrew.ts",
    "install:local": "sh scripts/install.sh",
    "readme-images": "bun scripts/readme-images/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@opentui/core": "0.5.12"
  }
}
